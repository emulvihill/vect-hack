# 03:30, when nobody is using the GPU. Persistent=true so a run missed because
# the machine was off fires at the next boot instead of being skipped silently —
# a gate that only runs when the machine happens to be awake is back to being
# remembered.
[Unit]
Description=Nightly vect-hack browser gates (GPU)

[Timer]
OnCalendar=*-*-* 03:30
Persistent=true

[Install]
WantedBy=timers.target
