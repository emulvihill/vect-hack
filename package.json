{
  "name": "vect-hack",
  "description": "VectHack — NetHack 5.0, Angband 4.2, Larn 12.0, and Umoria 5.7 cores compiled to WebAssembly and rendered as vector graphics",
  "author": "Eric Mulvihill",
  "license": "SEE LICENSE IN LICENSING.md",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build/stage-licenses.mjs",
    "serve:www": "vite build --base /play/ && node scripts/build/stage-licenses.mjs && node scripts/dev/serve-www.mjs",
    "typecheck": "tsc",
    "lint": "eslint .",
    "setup": "scripts/build/setup-toolchain.sh && npm run build:engines",
    "setup:toolchain": "scripts/build/setup-toolchain.sh",
    "build:engines": "npm run build:nethack && npm run build:angband && npm run build:larn && npm run build:moria",
    "build:nethack": "scripts/build/build-nethack-wasm.sh",
    "build:angband": "scripts/build/build-angband-wasm.sh",
    "build:larn": "scripts/build/build-larn-wasm.sh",
    "build:moria": "scripts/build/build-moria-wasm.sh",
    "test:nethack-boot": "timeout 60 node scripts/test/nethack/test-nethack-boot.mjs",
    "test:nethack-persist": "timeout 60 node scripts/test/nethack/test-nethack-persistence.mjs",
    "test:nethack-save-restore": "timeout 120 node scripts/test/nethack/test-nethack-save-restore.mjs",
    "test:nethack-tabs": "timeout 60 node scripts/test/nethack/test-nethack-tabs.mjs",
    "test:nethack-autosave": "timeout 180 node scripts/test/nethack/test-nethack-autosave.mjs",
    "test:nethack": "vitest run --project engine-nethack",
    "test:angband-boot": "timeout 120 node scripts/test/angband/test-angband-boot.mjs",
    "test:angband-persist": "timeout 120 node scripts/test/angband/test-angband-persistence.mjs",
    "test:angband-save-restore": "timeout 180 node scripts/test/angband/test-angband-save-restore.mjs",
    "test:angband-autosave": "timeout 180 node scripts/test/angband/test-angband-autosave.mjs",
    "test:angband-borg": "timeout 120 node scripts/test/angband/test-angband-borg.mjs",
    "test:angband-borg-pace": "timeout 60 node scripts/test/angband/test-angband-borg-pace.mjs",
    "test:angband-borg-death": "timeout 120 node scripts/test/angband/test-angband-borg-death.mjs",
    "test:angband": "vitest run --project engine-angband",
    "test:larn-boot": "timeout 120 node scripts/test/larn/test-larn-boot.mjs",
    "test:larn-seed": "timeout 240 node scripts/test/larn/test-larn-seed.mjs",
    "test:larn-repro": "timeout 420 node scripts/test/larn/test-larn-repro.mjs",
    "test:larn-trace": "timeout 900 node scripts/test/larn/test-larn-trace.mjs",
    "test:larn-persist": "timeout 120 node scripts/test/larn/test-larn-persistence.mjs",
    "test:larn-save-restore": "timeout 180 node scripts/test/larn/test-larn-save-restore.mjs",
    "test:larn-autosave": "timeout 180 node scripts/test/larn/test-larn-autosave.mjs",
    "test:larn-map-contract": "timeout 120 node scripts/test/larn/test-larn-map-contract.mjs",
    "test:larn-status": "timeout 180 node scripts/test/larn/test-larn-status-tap.mjs",
    "test:larn-savefile": "timeout 180 node scripts/test/larn/test-larn-savefile-confinement.mjs",
    "test:larn-gym": "timeout 300 node scripts/test/larn/test-larn-gym.mjs",
    "test:larn-killer": "timeout 300 node --experimental-strip-types scripts/test/larn/test-larn-killer.mjs",
    "test:larn": "vitest run --project engine-larn",
    "test:moria-boot": "timeout 120 node scripts/test/moria/test-moria-boot.mjs",
    "test:moria-play": "timeout 120 node scripts/test/moria/test-moria-play.mjs",
    "test:moria-checkpoint-native": "timeout 120 node scripts/test/moria/test-moria-checkpoint-native.mjs",
    "test:moria-map-contract": "timeout 120 node scripts/test/moria/test-moria-map-contract.mjs",
    "test:moria-persist": "timeout 180 node scripts/test/moria/test-moria-persistence.mjs",
    "test:moria-save-restore": "timeout 180 node scripts/test/moria/test-moria-save-restore.mjs",
    "test:moria-tabs": "timeout 180 node scripts/test/moria/test-moria-tabs.mjs",
    "test:moria-autosave": "timeout 180 node scripts/test/moria/test-moria-autosave.mjs",
    "test:moria-overlay": "timeout 240 node scripts/test/moria/test-moria-overlay.mjs",
    "test:moria-build-contract": "timeout 900 node scripts/test/moria/test-moria-build-contract.mjs --require-build",
    "test:moria": "vitest run --project engine-moria",
    "test:render": "vitest run --project unit",
    "test:engines": "vitest run --project \"engine-*\"",
    "bot:headless": "node scripts/dev/bot-gym.mjs",
    "check:browser": "node scripts/dev/browser-check.mjs",
    "check:controls": "node scripts/dev/fp-controls-check.mjs",
    "check:angband-borg": "node scripts/dev/angband-borg-check.mjs",
    "check:overlay": "node scripts/dev/overlay-layout-check.mjs",
    "check:touch": "npm run check:overlay && node scripts/dev/touch-check.mjs",
    "check:payload": "node scripts/dev/payload-check.mjs",
    "check:gates": "node scripts/dev/gate-run.mjs",
    "preview:mobile": "node scripts/dev/mobile-preview.mjs",
    "test": "npm run typecheck && vitest run",
    "preview": "vitest run scripts/dev/scene-preview.test.ts scripts/dev/radar-preview.test.ts && (magick .preview/nethack-scene.ppm .preview/nethack-scene.png 2>/dev/null && echo .preview/nethack-scene.png || echo .preview/nethack-scene.ppm) && (magick .preview/nethack-scene-fp.ppm .preview/nethack-scene-fp.png 2>/dev/null && echo .preview/nethack-scene-fp.png || echo .preview/nethack-scene-fp.ppm) && (magick .preview/angband-scene.ppm .preview/angband-scene.png 2>/dev/null && echo .preview/angband-scene.png || echo .preview/angband-scene.ppm) && (magick .preview/angband-scene-fp.ppm .preview/angband-scene-fp.png 2>/dev/null && echo .preview/angband-scene-fp.png || echo .preview/angband-scene-fp.ppm) && (magick .preview/radar.svg .preview/radar.png 2>/dev/null && echo .preview/radar.png || echo .preview/radar.svg)"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.1",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
